# Salin menjadi .env lalu sesuaikan.
PORT=3000
# Akun admin pertama (dibuat sekali, saat database masih tanpa admin).
# Bila ADMIN_PASSWORD kosong, password acak dicetak di konsol.
ADMIN_EMAIL=admin@sendangduwur.local
ADMIN_NAME=Admin Desa
ADMIN_PASSWORD=
# Produksi: aktifkan cookie Secure dan HSTS (wajib HTTPS).
NODE_ENV=development
# Di belakang proxy/hosting (Nginx, Railway, Render): isi true.
TRUST_PROXY=
# Alamat publik situs, dipakai untuk redirect Google OAuth.
BASE_URL=http://localhost:3000
# Login Google (opsional). Panduan lengkap: GOOGLE_SETUP.md
# Redirect URI yang didaftarkan di Google Cloud: {BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Asisten wisata AI (opsional). Kosong = jawaban lokal dari basis pengetahuan situs.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Lokasi database (default: ./data)
DATA_DIR=
